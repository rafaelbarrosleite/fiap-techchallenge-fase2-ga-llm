.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Modelos serializados, notebooks executados e arquivos temporarios
*.joblib
*.pkl
*.log
.ipynb_checkpoints/
notebooks/*-executed.ipynb

# Evidencias reproduziveis publicadas; demais saidas continuam locais
artifacts/**
!artifacts/.gitkeep
!artifacts/**/
!artifacts/**/*.json
!artifacts/**/*.csv

# Pipelines congelados da avaliacao final (1,5 MB): exigidos pela trilha
# de explicacao individual e pela verificacao de hashes dos manifestos.
!artifacts/final_evaluation/models/*.joblib

reports/**
!reports/.gitkeep
!reports/figures/
!reports/figures/**/
!reports/figures/**/*.png
!reports/figures/**/*.json

# O painel e derivado, mas e versionado para que a banca o abra a partir de um
# clone sem executar nada. Um teste garante que o arquivo comitado corresponde a
# uma construcao nova, entao ele nao pode ficar defasado em silencio.
!reports/dashboard/
!reports/dashboard/index.html

logs/*
!logs/.gitkeep

# Credenciais de provedores e ferramentas
.env.*
!.env.example
